<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de extracción de datos para API 31+: copia en la nube y
   transferencia directa entre dispositivos (ver S3 en docs/code-review.md).

   Mismo motivo que backup_rules.xml: los EncryptedSharedPreferences dependen
   de una clave del Android Keystore que no viaja fuera del dispositivo, así
   que no tiene sentido —y puede dejar la app en un estado corrupto—
   incluirlos en ninguna de las dos rutas de backup/restauración.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="acheron_secure_prefs.xml" />
        <exclude domain="sharedpref" path="acheron_biometric_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="acheron_secure_prefs.xml" />
        <exclude domain="sharedpref" path="acheron_biometric_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
